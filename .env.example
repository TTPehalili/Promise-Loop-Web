# Public URLs used by the marketing site
NEXT_PUBLIC_SITE_URL=https://promiseloop.com
# Where "Book a demo" / "Get your quote" go (calendar link). Falls back to email.
NEXT_PUBLIC_DEMO_URL=
# Where "Log in" goes (the PromiseLoop app login page)
NEXT_PUBLIC_APP_LOGIN_URL=

# Local only: mock-call audio generation (never used by the app)
ELEVENLABS_API_KEY=

# --- Assistant (website chat widget) -----------------------------------------
# Every variable is optional: without them the site still builds and runs.
# Model (chat returns 503 "unavailable" when the key is missing)
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-haiku-5-5
# Optional stronger model after 12 visitor turns
ASSISTANT_MODEL_HARD=
# full = whole knowledge pack in the cached prompt | vector = pgvector hybrid search (Phase 2)
ASSISTANT_RETRIEVAL=full
# Data (server only; in-memory store when unset, lost on restart)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Phase 2 embeddings (ingest script + vector retrieval). 1024-dim model.
EMBEDDINGS_API_KEY=
EMBEDDINGS_API_URL=
EMBEDDINGS_MODEL=
# Scheduling (Cal.com API v2). When unset, the chat shows the NEXT_PUBLIC_DEMO_URL booking link.
SCHEDULING_API_KEY=
SCHEDULING_EVENT_ID=
SCHEDULING_API_BASE=https://api.cal.com/v2
SCHEDULING_RESCHEDULE_BASE=https://app.cal.com/reschedule
SCHEDULING_SLOTS_API_VERSION=2024-09-04
SCHEDULING_BOOKINGS_API_VERSION=2026-02-25
# Email (hand-off, booking alert, confirmation). Logged to the server console when unset.
RESEND_API_KEY=
ASSISTANT_FROM_EMAIL="PromiseLoop <hello@promiseloop.com>"
ASSISTANT_ALERT_EMAIL=hello@promiseloop.com
ASSISTANT_SLACK_WEBHOOK_URL=
ASSISTANT_HANDOFF_SLA="one US business day"
# Consumer contact for people who got a call about a bill (falls back to hello@promiseloop.com)
REDIRECT_CONTACT=
# Eval runner only: shared secret (>= 16 chars) that skips the IP rate limit
ASSISTANT_EVAL_TOKEN=
